    cur_px cur_price price
    mult ib_mult ib_multiplier multiplier
    notional notional_native
    daily_ret_vol ann_ret_vol daily_pt_vol daily_point_vol
    daily_dvol ann_dvol risk_traded_usd_day mkt_risk_vol_usd_day
    pct_mkt_volume min_daily_volume max_pct_mkt_volume
    spread_pts spread_points comm comm_usd
    init_margin init_margin_usd maint_margin maint_margin_usd
    margin_fx_to_usd comm_native spread_cash_native cost_native cost_usd
    trade_sr roll_sr rule_cost_lim_sr cost_lim_sr max_ann_dvol
    init_capital_usd target_vol cost_limit_sr
    risk_target daily_risk_pts ann_risk_pts
    max_position max_weight_idm max_instr_margin_pct max_book_margin_pct
    average_daily_volume avg_daily_volume one_way_cost_per_dvol
    score base_score construction_score base_construction_score
    iter_best_score iter_score_best_score tie_score_floor min_accept_score
    idm weight limit_weight
    score_cost_sr ann_trade_cost_sr ann_roll_cost_sr ann_cost_sr
    base_net_sr net_sr size_penalty_sr
    low_con_penalty_sr high_con_penalty_sr con_band_penalty_sr
    low_con_penalty_scale high_con_penalty_scale
    con_band_min con_band_max score_tie_tolerance_pct
    ref_weight ref_idm ref_weight_idm ref_max_position
    ref_con_band_distance candidate_ref_max_position
    candidate_ref_con_band_distance low_con_weight band_con_weight high_con_weight
    score_denom marg_score scaled_contrib
    avg_pos ann_trade_cons ann_roll_cons ann_con_load max_cons
    trade_cost_per_con roll_cost_per_con
    ann_trade_cost ann_roll_cost ann_cost
    trade_cost_usd_per_con roll_cost_usd_per_con
    ann_trade_cost_usd ann_roll_cost_usd ann_cost_usd
    portfolio_init_margin portfolio_maint_margin
    portfolio_init_margin_usd portfolio_maint_margin_usd
    init_margin_change maint_margin_change
    init_margin_pct_cap book_margin_pct_cap
    cluster_weight cluster_score fdm comb_turnover
    combined_forecast reference_average_position reference_target_position
    smoothed_reference_average_position reference_normalized_position
    reference_abs_position_change reference_rolling_mean_abs_position_change
    reference_rolling_ann_turnover
    close point_change point_vol fx_to_usd period_year_fraction
    pnl_avg_position pnl_position held_pnl_position gross_pnl_pts
    gross_pnl_native gross_pnl_usd ann_cost_pts cost_pnl_pts
    cost_pnl_native cost_pnl_usd net_pnl_usd risk_budget_usd
    reference_weight reference_idm reference_weight_idm
    reference_annual_risk_budget_usd reference_daily_risk_budget_usd
    reference_return_capital_usd ref_ann_risk_usd ref_daily_risk_usd
    ref_ret_cap_usd daily_dollar_vol_per_contract
    reference_average_position reference_target_position
    held_reference_position ref_avg_pos ref_targ_pos held_ref_pos
    reference_gross_return reference_annual_cost_return
    reference_cost_return reference_net_return
    ref_gross_ret ref_ann_cost_ret ref_cost_ret ref_net_ret
    targ_pos buf_size buffer_size buf_width_pos
    buffer_top_cons buffer_bot_cons exec_cons held_cons trade_cons
    realized_roll_cons interval_avg_abs_cons expected_roll_cons
    cash_gross_pnl_usd cash_trade_cost_usd
    cash_realized_roll_cost_usd cash_expected_roll_cost_usd
    cash_realized_net_pnl_usd cash_expected_net_pnl_usd
    cum_cash_gross_pnl_usd cum_cash_realized_net_pnl_usd
    cum_cash_expected_net_pnl_usd
