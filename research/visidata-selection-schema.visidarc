# Rule columns vary with the configured forecast speeds; cover the standard set.
for _fast, _slow in ((4, 16), (8, 32), (16, 64), (32, 128), (64, 256)):
    Sheet.knownCols[f"fcst_{_fast}_{_slow}"].type = float
