# VisiData column types for the futures selection CSV and Parquet reports.
#
# Load this file from ~/.visidatarc (for example: exec(open(".../visidata-selection-schema.visidarc").read())).
# Parquet files preserve their native schema; these declarations are most useful
# for CSVs, where values otherwise arrive as strings.


def _vd_set_type(names, dtype):
    """Assign one VisiData type to a whitespace-separated set of columns."""
    for name in names.split():
        Sheet.knownCols[name].type = dtype


# Identifiers, labels, categories, serialized dictionaries, and explanatory text.
_vd_set_type(
    """
    symbol signal_symbol hist_instr_code desc description
    asset_cls econ_subcls region econ_fam_id
    roll_policy_id dup_grp_id pool_role rep_instr exec_prof
    con_id expiry ib_symbol ib_exch ib_ccy ib_avail ccy currency
    cur_px_src cur_fx_src cur_fx_pair cur_fx_mkt_data_type cur_fx_err
    vol_src volume_src spread_src comm_ccy comm_src cost_qual
    margin_ccy margin_fx_src
    whatif_error_codes whatif_error_req_ids whatif_reject_reason
    whatif_error whatif_warning whatif_retry_error
    exec_restrict_reason selection_excl sel_bucket
    elig_ewmac_rules forecast_weights forecast_excl subsystem_excl
    fx_pair fx_src fx_error reason instr_reason
    candidate book added_symbol iter_best iter_score_best
    wt_policy cluster_path cluster_members
    snap_hist_duration snap_spread_duration snap_volume_duration
    snap_req_market_data_type snap_vol_src snap_market_data_type
    snap_error_codes snap_selected_error_codes snap_spread_quality
    ref_vol_source ref_spread_source ref_strategy_instrument
    ref_strategy_roll_policy ref_strategy_hold_roll_cycle
    ref_strategy_roll_rate_audit
    ib_fast_duration ib_fast_bar_size ib_fast_market_data_type
    ib_hspread_duration ib_hspread_bar_size ib_hspread_source
    """,
    str,
)

# Calendar dates. Expiry is deliberately text above: it is a contract identifier,
# not a date value (and may contain exchange-specific formatting).
_vd_set_type(
    """
    date volume_start volume_end forecast_start forecast_end
    pnl_start pnl_end reference_return_start reference_return_end
    ref_ret_start ref_ret_end
    fx_start fx_end fx_date
    ref_history_start ref_history_end
    ref_strategy_history_start ref_strategy_history_end
    ib_fast_start ib_fast_end ib_hspread_start ib_hspread_end
    """,
    date,
)

# ISO-formatted timestamp columns in CSV reports. Older VisiData releases may
# not expose a separate datetime type; its date type can still parse ISO values.
try:
    _vd_datetime_type = datetime
except NameError:
    _vd_datetime_type = date

_vd_set_type(
    "report_ts_ct snap_cache_ts_ct snap_quote_timestamp_ct fx_source_ts",
    _vd_datetime_type,
)

# Eligibility, validity, feasibility, and event flags.
_vd_set_type(
    """
    exec_elig whatif_attempted whatif_elig cost_elig size_elig data_elig
    volume_elig risk_volume_elig liq_elig selection_elig
    instr_has_elig_ewmac_rule include_default_pool
    forecast_elig subsystem_elig forecast_valid fx_valid pnl_valid
    reference_return_valid ref_ret_valid
    cash_fx_valid cash_pnl_valid ret_valid is_roll roll_event feasible accepted
    tie_eligible tie_break_applied
    roll_cost_in_score buf_trade_to_edge snap_use_rth
    main_instr_afford_for_scen counts_toward_main_instr_min
    equal_wt_meets_min_cons ib_fast_requests_allowed
    """,
    bool,
)

# Counts, ranks, spans, and retry/observation counts.
_vd_set_type(
    """
    rank selection_step iteration max_instr_per_cluster reference_book_count
    ref_book_n tie_ref_book_n book_n_instr pnl_valid_n_instr
    eligible_ewmac_rule_count volume_n ann_days liq_days
    history_obs forecast_valid_obs forecast_invalid_obs
    forecast_post_warmup_invalid_obs combined_nulls combined_nonfinite
    pnl_valid_obs pnl_post_start_invalid_obs
    reference_return_valid_obs reference_return_post_start_invalid_obs
    ref_ret_valid_obs ref_ret_post_start_invalid_obs
    fx_missing_forecast_obs
    whatif_expiry_attempts whatif_retry_n
    ib_fast_n ib_hspread_n ib_hspread_attempts ib_hspread_failures
    ref_history_n ref_vol_n ref_strategy_history_n
    ref_strategy_rolls_full ref_strategy_recent_rolls
    ref_strategy_recent_start_year ref_strategy_recent_end_year
    ib_price_magnifier price_magnifier
    """,
    int,
)

# Prices, contract sizes, volatility, dollar risk/cost, weights, scores,
